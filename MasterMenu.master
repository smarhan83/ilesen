        <script>
            $(function () {
                //Initialize Select2 Elements
                $('.select2').select2({
                    width: '100%',
                    dropdownAutoWidth: true
                });

                //Initialize Select2 Elements
                $('.select2bs4').select2({
                    theme: 'bootstrap4'
                })

                //Datemask dd/mm/yyyy
                $('#datemask').inputmask('dd/mm/yyyy', { 'placeholder': 'dd/mm/yyyy' })
                //Datemask2 mm/dd/yyyy
                $('#datemask2').inputmask('mm/dd/yyyy', { 'placeholder': 'mm/dd/yyyy' })
                //Money Euro
                $('[data-mask]').inputmask()

                //Date picker
                $('#reservationdate').datetimepicker({
                    format: 'L'
                });

                //Date and time picker
                $('#reservationdatetime').datetimepicker({ icons: { time: 'far fa-clock' } });

                //Date range picker
                $('#reservation').daterangepicker()
                //Date range picker with time picker
                $('#reservationtime').daterangepicker({
                    timePicker: true,
                    timePickerIncrement: 30,
                    locale: {
                        format: 'MM/DD/YYYY hh:mm A'
                    }
                })
                //Date range as a button
                $('#daterange-btn').daterangepicker(
                    {
                        ranges: {
                            'Today': [moment(), moment()],
                            'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                            'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                            'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                            'This Month': [moment().startOf('month'), moment().endOf('month')],
                            'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                        },
                        startDate: moment().subtract(29, 'days'),
                        endDate: moment()
                    },
                    function (start, end) {
                        $('#reportrange span').html(start.format('MMMM D, YYYY') + ' - ' + end.format('MMMM D, YYYY'))
                    }
                )

                //Timepicker - 
                $('#timepicker').datetimepicker({
                    format: 'LT'
                })

                //Bootstrap Duallistbox
                $('.duallistbox').bootstrapDualListbox()

                //Colorpicker
                $('.my-colorpicker1').colorpicker()
                //color picker with addon
                $('.my-colorpicker2').colorpicker()

                $('.my-colorpicker2').on('colorpickerChange', function (event) {
                    $('.my-colorpicker2 .fa-square').css('color', event.color.toString());
                })
            })



        </script>

        <script>
            // Pautan muat turun (a[download] / data-no-loader) mencetuskan beforeunload tetapi page tidak bertukar,
            // jadi loader tidak akan hilang - langkau loader untuk klik tersebut.
            var skipPageLoader = false;
            document.addEventListener("click", function (e) {
                if (e.target.closest && e.target.closest("a[download], [data-no-loader]")) {
                    skipPageLoader = true;
                    setTimeout(function () { skipPageLoader = false; }, 1000);
                }
            }, true);

            window.addEventListener("beforeunload", function () {
                if (skipPageLoader) return;
                document.getElementById("pageLoader").style.display = "flex";
            });

            // Kembali melalui butang Back (bfcache) - pastikan loader disembunyikan
            window.addEventListener("pageshow", function () {
                document.getElementById("pageLoader").style.display = "none";
            });
        </script>


            <script>
                function applyMobileLabels() {

                    $('.table-bordered').each(function () {

                        var headers = [];

                        $(this).find('th').each(function () {

                            // Auto add keep-header jika ada control
                            if ($(this).find('.btn').length > 0) {
                                $(this).addClass('keep-header');
                            }

                            headers.push($(this).text().trim());
                        });

                        $(this).find('tbody tr').each(function () {

                            $(this).find('td').each(function (i) {

                                $(this).attr('data-label', headers[i]);

                                // Skip jika ada button/link/input
                                if ($(this).find('.btn').length > 0) {
                                    return;
                                }

                                var value = $(this)
                                    .text()
                                    .replace(/\u00A0/g, '')
                                    .trim();

                                //if (value === '') {
                                //    $(this).hide();
                                //} else {
                                //    $(this).show();
                                //}

                            });

                        });

                    });

                }

                $(document).ready(function () {
                    applyMobileLabels();
                });

                if (typeof (Sys) !== "undefined") {

                    Sys.WebForms.PageRequestManager
                        .getInstance()
                        .add_endRequest(function () {
                            applyMobileLabels();
                        });

                }

            </script>

    </form>



    <script>
        function applyGridButtonIcon() {

            var iconMap = {
                "Kemaskini": "bi bi-pencil",
                "Nyah Aktif": "bi bi-slash-circle",
                "Padam": "bi bi-trash",
                "Lihat": "bi bi-eye",
                "+": "bi bi-plus-circle"
            };

            $('.table-bordered .btn').each(function () {
                var $btn = $(this);

                // dah pernah diproses - skip terus, elak duplicate
                if ($btn.data('icon-applied')) {
                    return;
                }

                if ($btn.closest('.no-action-dropdown').length || $btn.closest('.banting-lokasi-list').length) {
                    return;
                }

                var text = $btn.text().trim();

                if (iconMap.hasOwnProperty(text)) {
                    $btn.attr('title', text);
                    $btn.addClass('btn-action-icon');
                    $btn.html('<i class="' + iconMap[text] + '"></i>');
                    $btn.data('icon-applied', true);
                }
            });
        }

        $(document).ready(function () {
            applyGridButtonIcon();
        });

        if (typeof (Sys) !== "undefined") {
            Sys.WebForms.PageRequestManager.getInstance()
                .add_endRequest(function () {
                    applyGridButtonIcon();
                });
        }

    </script>

    <script src="<%= ResolveUrl("~/js/auto-icon-button.js") %>"></script>


    <script>
        function convertActionButtonsToDropdown() {

            if (window.innerWidth <= 768) return;

            document.querySelectorAll('.table-bordered td').forEach(function (td) {
                if (td.dataset.dropdownConverted === "1") return;

                if (td.classList.contains('no-action-dropdown') || td.closest('.no-action-dropdown') || td.closest('.banting-lokasi-list') || td.querySelector('input, select, textarea, .card, .location-card')) {
                    return;
                }

                var actionButtons = td.querySelectorAll(
                    'a.btn-warning.btn-sm, a.btn-primary.btn-sm, a.btn-danger.btn-sm, a.btn-info.btn-sm, a.btn-success.btn-sm, a.btn-outline-primary.btn-sm, a.btn-outline-secondary.btn-sm, a.btn-outline-info.btn-sm, a.btn-outline-danger.btn-sm'
                );

                // kalau takde button, atau cuma 1 button je - skip, tak payah convert
                if (actionButtons.length <= 1) return;

                var wrapper = document.createElement('div');
                wrapper.className = 'dropdown';

                var toggleBtn = document.createElement('button');
                toggleBtn.type = 'button';
                toggleBtn.className = 'btn btn-action-dots';
                toggleBtn.setAttribute('data-bs-toggle', 'dropdown');
                toggleBtn.setAttribute('aria-expanded', 'false');
                toggleBtn.innerHTML = '<i class="bi bi-three-dots-vertical"></i>';

                var menu = document.createElement('ul');
                menu.className = 'dropdown-menu action-dropdown-menu dropdown-menu-end';

                actionButtons.forEach(function (btn) {
                    var li = document.createElement('li');
                    var isDanger = btn.classList.contains('btn-danger') || btn.classList.contains('btn-outline-danger');
                    var label = btn.textContent.trim().toLowerCase();

                    btn.classList.remove('btn', 'btn-warning', 'btn-primary', 'btn-danger', 'btn-info', 'btn-success', 'btn-outline-primary', 'btn-outline-secondary', 'btn-outline-info', 'btn-outline-danger', 'btn-sm', 'btn-action-icon');
                    btn.classList.add('dropdown-item');
                    btn.classList.add(isDanger ? 'text-danger' : 'text-primary');

                    // guna title attribute sebagai fallback label kalau text dah kosong (icon-only button)
                    if (!label && btn.title) {
                        label = btn.title.trim().toLowerCase();
                    }

                    var iconClass = 'bi bi-chevron-right me-2';
                    if (label.includes('nyah') || label.includes('padam') || label.includes('delete')) {
                        iconClass = 'bi bi-slash-circle me-2';
                    } else if (label.includes('lihat')) {
                        iconClass = 'bi bi-eye me-2';
                    } else if (label.includes('surat')) {
                        iconClass = 'bi bi-envelope me-2';
                    } else if (label.includes('kemaskini') || label.includes('kemas kini')) {
                        iconClass = 'bi bi-pencil me-2';
                    } else if (label.includes('lampiran')) {
                        iconClass = 'bi bi-paperclip me-2';
                    }

                    // KUNCI FIX: kalau dah ada icon sedia ada, buang dulu sebelum insert baru
                    // (elak double icon bila applyGridButtonIcon dah insert icon awal)
                    var existingIcon = btn.querySelector('i');
                    if (existingIcon) {
                        existingIcon.remove();
                    }

                    // pulihkan text label balik (sebab applyGridButtonIcon dah kosongkan text tadi)
                    if (btn.textContent.trim() === '' && btn.title) {
                        btn.textContent = btn.title;
                    }

                    var icon = document.createElement('i');
                    icon.className = iconClass;
                    btn.prepend(icon);

                    li.appendChild(btn);
                    menu.appendChild(li);
                });

                wrapper.appendChild(toggleBtn);
                wrapper.appendChild(menu);
                td.innerHTML = '';
                td.appendChild(wrapper);
                td.dataset.dropdownConverted = "1";
            });
        }

        document.addEventListener('DOMContentLoaded', convertActionButtonsToDropdown);
        if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(convertActionButtonsToDropdown);
        }
    </script>

  <script>
      // Year footer
      document.getElementById("yearNow").innerText = new Date().getFullYear();

      // ====== Slider Logic (jQuery) ======
      const $slides = $("#heroSlider .hero-slide");
      const $dotsContainer = $("#sliderDots");
      let currentIndex = 0;
      let timer = null;

      function renderDots() {
          $dotsContainer.html("");
          $slides.each(function (i) {
              const dot = $('<div class="dot"></div>');
              if (i === currentIndex) dot.addClass("active");
              dot.on("click", function () {
                  goToSlide(i);
                  restartTimer();
              });
              $dotsContainer.append(dot);
          });
      }

      function goToSlide(index) {
          $slides.removeClass("active");
          $slides.eq(index).addClass("active");
          currentIndex = index;
          renderDots();
      }

      function nextSlide() {
          const next = (currentIndex + 1) % $slides.length;
          goToSlide(next);
      }

      function startTimer() {
          timer = setInterval(nextSlide, 4500);
      }

      function restartTimer() {
          clearInterval(timer);
          startTimer();
      }

      renderDots();
      startTimer();

      // ====== Fake Login / Logout Navigation ======
      function showAdmin() {
          //$("#homePage").hide();
          //$("#adminPage").show();
          //window.scrollTo(0, 0);
      }

      function showHome() {
          //$("#adminPage").hide();
          //$("#homePage").show();
          //window.scrollTo(0, 0);
      }

      //$("#btnLogin, #btnQuickLogin1").on("click", function (e) {
      //    e.preventDefault();
      //    showAdmin();
      //});

      $("#btnLogoutTop, #btnLogoutSide").on("click", function (e) {
          e.preventDefault();
          showHome();
      });

      $("#btnBackHome, #navHome").on("click", function (e) {
          e.preventDefault();
          showHome();
      });
  </script>


    
