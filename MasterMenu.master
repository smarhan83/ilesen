    </style>

  <style>
    :root{
      --pastel-1:#EAF6FF; /* light blue */
      --pastel-2:#FFF1F5; /* light pink */
      --pastel-3:#F2FFF4; /* light green */
      --pastel-4:#FFF9E6; /* light yellow */
      --primary:#2D6CDF;
      --text:#1f2937;
      --muted:#6b7280;
      --card:#ffffff;
      --shadow: 0 10px 30px rgba(16, 24, 40, 0.08);
      --radius: 22px;
    }

    body{
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color: var(--text);
      background: linear-gradient(135deg, var(--pastel-1), var(--pastel-2));
      min-height: 100vh;
    }

    /* ====== Common ====== */
    .soft-card{
      background: rgba(255,255,255,0.92);
      border: 1px solid rgba(17,24,39,0.06);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
    }

    .btn-soft{
      border-radius: 999px;
      padding: 10px 16px;
      border: 1px solid rgba(45,108,223,0.15);
      background: rgba(45,108,223,0.08);
      color: var(--primary);
      font-weight: 600;
    }
    .btn-soft:hover{
      background: rgba(45,108,223,0.14);
      color: var(--primary);
    }

    .badge-soft{
      background: rgba(45,108,223,0.10);
      color: var(--primary);
      border: 1px solid rgba(45,108,223,0.12);
      border-radius: 999px;
      padding: 6px 10px;
      font-weight: 600;
      font-size: 12px;
    }

    /* ====== Navbar ====== */
    .navbar{
      background: rgba(255,255,255,0.75) !important;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(17,24,39,0.06);
    }

    .brand-wrap{
      display:flex;
      align-items:center;
      gap:28px; /* logo 87px melimpah kotak 42px (~22px setiap sisi); 28px = jarak ~5px dari teks */
    }
    .brand-mpk{ height:48px; width:auto; object-fit:contain; flex-shrink:0; margin-right:4px; }
    .brand-logo{
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(45,108,223,0.18), rgba(34,197,94,0.12));
      display:flex;
      align-items:center;
      justify-content:center;
      box-shadow: 0 10px 20px rgba(45,108,223,0.15);
      border: 1px solid rgba(45,108,223,0.10);
    }
	.brand-logo img{
	  height: 65px;
	  width: auto;
	  object-fit: contain;
	}

    .brand-logo i{
      color: var(--primary);
      font-size: 18px;
    }
    .brand-title{
      line-height: 1.1;
    }
    .brand-title strong{
      font-size: 16px;
      display:block;
    }
    .brand-title small{
      color: var(--muted);
      font-size: 12px;
    }

    .nav-link{
      font-weight: 600;
      color: rgba(31,41,55,0.85) !important;
    }
    .nav-link:hover{
      color: var(--primary) !important;
    }

    /* Footer: logo ProLesen + MPK */
    .footer-brand{ display: flex; align-items: center; gap: 16px; }
    .footer-logos{ display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .footer-logos img{ height: 46px; width: auto; object-fit: contain; }
    .footer-logo-sep{ width: 1px; height: 36px; background: rgba(17,24,39,0.12); }
    @media (max-width: 576px){
      .footer-brand{ flex-direction: column; align-items: flex-start; gap: 10px; }
      .footer-logos img{ height: 38px; }
    }

    /* Menu atas: pil kecil, font sederhana, ikon berwarna (navbar sahaja - sidebar tidak terjejas) */
    .navbar{ padding-top: 6px; padding-bottom: 6px; box-shadow: 0 1px 8px rgba(17,24,39,0.04); }
    .navbar .navbar-nav{ align-items: center; gap: 4px !important; }
    .navbar .navbar-nav .nav-link{
      font-size: 13.5px;
      font-weight: 600;
      color: #475467 !important;
      padding: 8px 14px !important;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      white-space: nowrap;
      transition: background .15s ease, color .15s ease;
    }
    .navbar .navbar-nav .nav-link i{ font-size: 15px; color: #2E3192; margin: 0 !important; }
    .navbar .navbar-nav .nav-link:hover{ background: #EEF0FF; color: #2E3192 !important; }
    .navbar .navbar-nav .nav-link.nav-login{ background: #2E3192; color: #fff !important; }
    .navbar .navbar-nav .nav-link.nav-login i{ color: #fff; }
    .navbar .navbar-nav .nav-link.nav-login:hover{ background: #23267a; }
    .navbar .dropdown{ margin-left: 10px; }
    @media (max-width: 991px){
      .navbar .navbar-nav{ align-items: stretch; }
      .navbar .navbar-nav .nav-link{ border-radius: 10px; }
      .navbar .dropdown{ margin: 8px 0 4px; }
    }

    /* ====== Hero Slider ====== */
    .hero{
      padding: 28px 0 10px 0;
    }

    .hero-slider{
      position: relative;
      overflow: hidden;
      border-radius: 30px;
      box-shadow: var(--shadow);
      border: 1px solid rgba(17,24,39,0.06);
      background: #fff;
    }

    .hero-slide{
      display:none;
      position: relative;
      height: 440px;
      background-size: cover;
      background-position: center;
    }
    .hero-slide.active{
      display:block;
      animation: fadeIn 600ms ease;
    }

    @keyframes fadeIn{
      from {opacity: 0.35; transform: scale(1.01);}
      to {opacity: 1; transform: scale(1);}
    }

    /* overlay gradient */
    .hero-slide::before{
      content:"";
      position:absolute;
      inset:0;
      background: linear-gradient(90deg, rgba(17,24,39,0.65), rgba(17,24,39,0.10));
    }

    /* curved info panel (NOT a box) */
    .hero-info{
      position:absolute;
      left: 26px;
      bottom: 26px;
      max-width: 520px;
      color: #fff;
      padding: 18px 20px;
      border-radius: 26px 26px 26px 8px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      backdrop-filter: blur(10px);
    }
    .hero-info h1{
      font-size: 28px;
      margin: 0 0 6px 0;
      font-weight: 800;
      letter-spacing: 0.2px;
    }
    .hero-info p{
      margin: 0;
      color: rgba(255,255,255,0.90);
      font-size: 14px;
      line-height: 1.5;
    }

    .hero-actions{
      margin-top: 12px;
      display:flex;
      gap:10px;
      flex-wrap: wrap;
    }
    .btn-hero{
      border-radius: 999px;
      padding: 10px 16px;
      font-weight: 700;
      border: 1px solid rgba(255,255,255,0.25);
      background: rgba(255,255,255,0.12);
      color: #fff;
    }
    .btn-hero:hover{
      background: rgba(255,255,255,0.20);
      color:#fff;
    }

    .slider-dots{
      position:absolute;
      right: 18px;
      bottom: 18px;
      display:flex;
      gap:8px;
      z-index: 3;
    }
    .dot{
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: rgba(255,255,255,0.45);
      border: 1px solid rgba(255,255,255,0.30);
      cursor:pointer;
    }
    .dot.active{
      background: rgba(255,255,255,0.95);
    }

    /* ====== Sections ====== */
    .section-title{
      font-size: 18px;
      font-weight: 800;
      margin: 0 0 6px 0;
    }
    .section-subtitle{
      color: var(--muted);
      margin: 0;
      font-size: 13px;
    }

    .feature-icon{
      width: 44px;
      height: 44px;
      border-radius: 16px;
      display:flex;
      align-items:center;
      justify-content:center;
      background: linear-gradient(135deg, rgba(45,108,223,0.14), rgba(34,197,94,0.10));
      border: 1px solid rgba(45,108,223,0.12);
    }
    .feature-icon i{
      color: var(--primary);
      font-size: 18px;
    }

    /* ====== Footer ====== */
    footer{
      color: rgba(31,41,55,0.75);
    }

    /* ====== Admin Layout ====== */
    #adminPage{
      /*display:none;*/
    }

    .admin-shell{
      display:flex;
      gap: 18px;
      padding: 18px 0;
    }

    .sidebar{
      width: 280px;
      padding: 16px;
      border-radius: var(--radius);
      background: rgba(255,255,255,0.86);
      border: 1px solid rgba(17,24,39,0.06);
      box-shadow: var(--shadow);
      height: calc(100vh - 120px);
      position: sticky;
      top: 90px;
      overflow:auto;
    }

    .sidebar .menu-title{
      font-size: 12px;
      color: var(--muted);
      font-weight: 800;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      margin: 14px 0 8px 0;
    }

    .sidebar a{
      text-decoration:none;
    }

    .side-item{
      display:flex;
      align-items:center;
      gap:10px;
      padding: 10px 12px;
      border-radius: 14px;
      color: rgba(31,41,55,0.85);
      font-weight: 450;
      transition: 0.2s ease;
      font-size : 10pt;
    }
    .side-item:hover{
      background: rgba(45,108,223,0.08);
      color: var(--primary);
    }
    .side-item i{
      font-size : 10pt;
      color: rgba(45,108,223,0.85);
    }

    .admin-main{
      flex: 1;
      min-width: 0;
    }

    .topbar{
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(17,24,39,0.06);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 12px 14px;
      display:flex;
      align-items:center;
      justify-content: space-between;
      gap: 12px;
    }

    .search-wrap{
      flex:1;
      max-width: 520px;
    }
    .search-wrap .form-control{
      border-radius: 999px;
      border: 1px solid rgba(17,24,39,0.08);
      background: rgba(255,255,255,0.9);
      padding-left: 42px;
    }
    .search-wrap{
      position:relative;
    }
    .search-wrap i{
      position:absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(31,41,55,0.45);
    }

    .profile-btn{
      display:flex;
      align-items:center;
      gap:10px;
      border-radius: 999px;
      padding: 4px 12px 4px 4px;
      border: 1px solid #E3E7F1;
      background: #fff;
      cursor:pointer;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .profile-btn:hover{ border-color: #C9CDF5; box-shadow: 0 2px 8px rgba(46,49,146,0.08); }
    .profile-btn img{
      width: 34px;
      height: 34px;
      border-radius: 999px;
      object-fit: cover;
      border: 2px solid #EEF0FF;
    }
    .profile-name{
      display: block;
      font-weight: 700;
      font-size: 12.5px;
      line-height: 1.2;
      color: #1F2937;
      max-width: 190px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .profile-role{
      font-size: 11px;
      color: var(--muted);
      font-weight: 600;
    }

    .stat-card{
      padding: 16px;
      border-radius: var(--radius);
      background: rgba(255,255,255,0.92);
      border: 1px solid rgba(17,24,39,0.06);
      box-shadow: var(--shadow);
      height: 100%;
    }
    .stat-card .stat-top{
      display:flex;
      align-items:center;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .stat-card h3{
      font-size: 22px;
      font-weight: 900;
      margin: 0;
    }
    .stat-card p{
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
    }

    .mini-table td, .mini-table th{
      padding: 12px 12px !important;
      vertical-align: middle;
    }

    /* Mobile adjustments */
    @media (max-width: 992px){
      .hero-slide{ height: 380px; }
      /*.sidebar{ display:none; }*/
      .admin-shell{ flex-direction: column; }
      .topbar{ flex-wrap: wrap; }
      .search-wrap{ max-width: 100%; }
    }

    @media (max-width:992px){

    .sidebar{
        position:fixed !important;
        left:-280px !important;
        top:0 !important;
        width:280px !important;
        height:100vh !important;
        padding:16px;
        z-index:9999 !important;
        overflow-y:auto;
        transition:left .3s ease !important;
        margin:0 !important;
    }

    .sidebar.show{
        left:0 !important;
    }

    }
	
/* ====== HERO Curve Style ====== */
.hero-curve{
  border-top-left-radius: 0 !important;
  border-top-right-radius: 0 !important;
}

/* Potong bentuk gambar jadi curve (bukan petak) */
.hero-clip{
  /*border-radius: 34px;*/
  clip-path: polygon(
    0% 0%,
    100% 0%,
    100% 82%,
    75% 92%,
    55% 84%,
    30% 95%,
    0% 88%
  );
}

/* Tambah ruang bawah sebab wave overlay */
.hero-slide{
  height: 470px;
}

/* Info panel jadi lebih organic (curve) */
.hero-info-curve{
  border-radius: 28px 28px 28px 10px;
  background: rgba(17,24,39,0.35);
  border: 1px solid rgba(255,255,255,0.18);
  backdrop-filter: blur(12px);
}

/* Wave bawah untuk nampak premium */
.hero-wave{
  position:absolute;
  left:0;
  right:0;
  bottom:-1px;
  height: 120px;
  z-index: 2;
  pointer-events: none;
}

.hero-wave svg{
  width: 100%;
  height: 100%;
  display:block;
}

/* Pastikan dots atas wave */
.slider-dots{
  z-index: 5;
}

/* Mobile tweak */
@media (max-width: 992px){
  .hero-slide{
    height: 400px;
  }
  .hero-clip{
    clip-path: polygon(
      0% 0%,
      100% 0%,
      100% 85%,
      70% 92%,
      45% 86%,
      20% 95%,
      0% 90%
    );
  }
}

.modal-content{
    border:none;
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 20px 60px rgba(0,0,0,.12);
}

.col-lg-7{
    padding:40px !important;
}

/* LABEL */
.form-label{
    font-size:13px;
    font-weight:700 !important;
    color:#374151;
    margin-bottom:8px;
}

/* INPUT WRAPPER */
.modern-input{
    position:relative;
    margin-bottom:4px;
}

/* INPUT */
.custom-input{
    height:56px;
    border:1px solid #E5E7EB !important;
    border-radius:14px !important;
    padding-left:52px !important;
    padding-right:52px !important;
    font-size:14px;
    background:#fff;
    transition:all .25s ease;
}

.custom-input:focus{
    border-color:#0d6efd !important;
    box-shadow:0 0 0 4px rgba(13,110,253,.10) !important;
}

/* ICON */
.input-icon{
    position:absolute;
    left:18px;
    top:50%;
    transform:translateY(-50%);
    font-size:18px;
    color:#94A3B8;
    z-index:10;
}

/* EYE BUTTON */
.eye-btn{
    position:absolute;
    right:18px;
    top:50%;
    transform:translateY(-50%);
    border:none;
    background:none;
    color:#94A3B8;
    padding:0;
    z-index:10;
}

.eye-btn:hover{
    color:#0d6efd;
}

/* LOGIN BUTTON */
/*.btn-primary{
    height:35px;
    border:none;
    border-radius:14px !important;
    font-weight:700 !important;
    background:linear-gradient(
        135deg,
        #2563eb,
        #0d6efd
    );
}

.btn-primary:hover{
    transform:translateY(-1px);
}*/

/* CHECKBOX */
/*.form-check-input{
    border-radius:5px;
}

.form-check-label{
    color:#6B7280;
}*/

/* FORGOT PASSWORD */
.btn-link{
    font-weight:600 !important;
}

/* TITLE */
h1{
    letter-spacing:-0.5px;
}

.modal-dialog{
    max-width:600px;
}

.modal-content{
    border:none;
    border-radius:20px;
    overflow:hidden;
}

.modal-body{
    padding:0 !important;
}

.col-lg-7{
    width:100%;
}

#loginModal .form-label{
    margin-bottom:8px;
}

#loginModal .mb-3{
    margin-bottom:20px !important;
}
	
  </style>

    <style>
        /*form left menu*/
.side-parent .parent-menu{
    display:flex;
    justify-content:space-between;
    align-items:center;
    font-weight : 600;
    font-size : 11pt;
}

.sub-menu{
    display:none;
    margin-top:4px;
}

.side-parent.active .sub-menu{
    display:block;
}

.sub-menu .side-item{
    padding-left:15px;
    font-size:11pt;
}

.menu-arrow{
    transition:.3s;
}

.side-parent.active .menu-arrow{
    transform:rotate(180deg);
}

.nav-icon{
    width:16px;
    height:16px;
    flex-shrink:0;
}
    </style>
<title>
<%=
    If(Request.Url.Host.ToLower() = "prolesen.mpkluang.gov.my",
                    "PRO-LESEN MPK",
                    "PRO-LESEN MPK (STAGING)")
%>
</title>
   

    <asp:ContentPlaceHolder ID="head" runat="server">

	

    </asp:ContentPlaceHolder>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>

    <!-- CUSTOM CSS WAJIB PALING BAWAH -->
    <link rel="stylesheet" href="~/css/custom-admin.css">
    <link rel="stylesheet" href="~/css/custom-admin-tab.css">
    <%--<link rel="stylesheet" href="~/css/table-style.css">--%>
    <link rel="stylesheet" href="~/css/gridview-style.css">

    <link rel="stylesheet" href="~/css/auto-icon-button.css" />
    <link rel="stylesheet" href="~/css/custom-kelulusan-sepanduk.css">
    

</head>

<body id="bodyTag" runat="server">
    <form id="form1" runat="server" enctype="multipart/form-data">

    <asp:ScriptManager ID="ScriptManager1" runat="server">
    </asp:ScriptManager>

    <!--AJAX POSTBACK LOADING-->
<asp:UpdateProgress runat="server" ID="PageUpdateProgress" DynamicLayout="true">
    <ProgressTemplate>

        <div class="loading-overlay">
            <div class="loading-box">

                <div class="loader-spinner"></div>

                <div class="loading-text">
                    Sila tunggu...
                </div>

            </div>
        </div>

    </ProgressTemplate>
</asp:UpdateProgress>

    <!--LOADING PAGE-->
    <div id="pageLoader" class="loading-overlay" style="display:none;">
        <div class="loading-box">
            <div class="loader-spinner"></div>
            <div class="loading-text">Sila tunggu...</div>
        </div>
    </div>


    <asp:Label ID="labelsession" runat="server" Text='<%#Session.Item("sessionSystemId") %>'></asp:Label>
        
          <!-- =======================
       NAVBAR (Shared)
        ======================== -->
        <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
		    <a class="navbar-brand text-decoration-none" href='<%= ResolveUrl("~/") %>' >
		        <div class="brand-wrap">
			    <img class="brand-mpk" src='<%= ResolveUrl("~/images/logo_mpk_new.png") %>' alt="Majlis Perbandaran Kluang" title="Majlis Perbandaran Kluang">
			    <div class="brand-logo">
			        <img src='<%= ResolveUrl("~/images/logo.png") %>' alt="Logo">
			    </div>

			    <div class="brand-title">
			        <strong>ProLesen</strong>
			        <small>Majlis Perbandaran Kluang</small>
			    </div>
		        </div>
		    </a>


            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto gap-lg-2 mt-3 mt-lg-0">
                <li class="nav-item">
                    <asp:LinkButton ID="lnkSemak" 
                        runat="server" 
                        CssClass="nav-link"
                        OnClick="lnkSemak_Click">
                        <i class="bi bi-journal-text me-1"></i>
                        Semak Permohonan
                    </asp:LinkButton>
                </li>
                <li class="nav-item"><a class="nav-link" href="#" title="Manual Pengguna Agensi &amp; Jabatan"><i class="bi bi-journal-check me-1"></i>Manual Pengguna</a></li>
                <li class="nav-item"><a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#modalPautanPantas" title="Pautan Pantas Pengguna"><i class="bi bi-lightning-charge me-1"></i>Pautan Pantas</a></li>
                <li class="nav-item"><a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#modalHubungi"><i class="bi bi-telephone me-1"></i>Hubungi Kami</a></li>
                <li class="nav-item">

                <% If CInt(Session.Item("sessionUsersId")) = 0 Then %>

                    <a class="nav-link nav-login"
                       href="#"
                       onclick="showLoginModal(); return false;">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Log Masuk

                    </a>

                <% Else %>

                    <%--<a class="nav-link"
                       href="/logout">
       
                        <i class="bi bi-box-arrow-right me-1"></i>Log Keluar

                    </a>--%>

                <% End If %>

            </ul>

                <% If CInt(Session.Item("sessionUsersId")) > 0 Then %>
                <div class="dropdown">


                    <div class="profile-btn" data-bs-toggle="dropdown" aria-expanded="false">
                    
                    <%--<asp:Image ID="imgProfile" CssClass="avatar-img" runat="server" />--%>
                    <div class="position-relative">

                        <asp:Image ID="imgProfile" 
                            CssClass="avatar-img" 
                            runat="server" />

                        <span class="position-absolute top-0 start-100 translate-middle 
                                     p-1 bg-danger border border-light rounded-circle blink"
                              runat="server"
                              id="idSpanNoti" visible="false">
                        </span>

                        <%--<span class="position-absolute top-0 start-100 translate-middle 
                                     badge rounded-pill bg-danger"
                              runat="server"
                              id="liNotification" visible="false">

                            <asp:Label ID="lblTotalNoti" runat="server"></asp:Label>

                        </span>--%>

                    </div>

                    <div class="d-none d-md-block">                        
                        <asp:Label ID="lblFullname1" runat="server" CssClass="profile-name"></asp:Label>
                        <div class="profile-role">Majlis Perbandaran Kluang</div>
                    </div>
                    <i class="bi bi-chevron-down ms-1 text-muted"></i>
                    </div>

<%--                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="border-radius:18px;" runat="server" id="profileInfo">
                    <li>
                        <a class="dropdown-item py-2" href="<%= ResolveUrl("~/administration/userprofile.aspx?p_Id=30&m_Id=36") %>">
                        <i class="bi bi-person-circle me-2"></i>Lihat Profil Pengguna
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" href="#">
                        <i class="bi bi-bell me-2"></i>Notifikasi
                        <span class="badge text-bg-primary ms-2">3</span>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item py-2 text-danger" href="/logout" >
                        <i class="bi bi-box-arrow-right me-2"></i>Log Keluar
                        </a>
                    </li>
                    </ul>--%>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0"
                        style="border-radius:18px; min-width:320px;"
                        runat="server"
                        id="profileInfo">

                        <!-- Profile -->
                        <li>
                            <a class="dropdown-item py-2"
                               href="<%= ResolveUrl("~/administration/userprofile.aspx?p_Id=30&m_Id=36") %>">

                                <i class="bi bi-person-circle me-2"></i>
                                Lihat Profil Pengguna

                            </a>
                        </li>


                        <!-- Divider -->
                        <li>
                            <hr class="dropdown-divider">
                        </li>


                        <!-- Notification Header -->
                        <li>
                            <h6 class="dropdown-header">
                                <i class="bi bi-bell me-2"></i>
                                Notifikasi
                            </h6>
                        </li>


                        <!-- Notification Permit Sementara Perniagaan Tamat Tempoh -->
                        <li>
                            <a class="dropdown-item py-2"
                               href="<%= ResolveUrl("~/lesen/appregister1.aspx?p_Id=3348&m_Id=4357&statusPermit=expired") %>">

                                <i class="bi bi-clock-history text-danger me-2"></i>
                                Tamat Tempoh - Permit Sementara

                                <span class="badge bg-danger ms-2">
                                    <asp:Label ID="lblNotiPermitExpired" runat="server"></asp:Label>
                                </span>

                            </a>
                        </li>


                        <!-- Notification 1 -->
                        <li>
                            <a class="dropdown-item py-2"
                               href="<%= ResolveUrl("~/lesen/kelulusan.aspx?p_Id=3351&m_Id=3352") %>">

                                <i class="bi bi-check-circle text-primary me-2"></i>
                                Kelulusan - Pendaftaran

                                <span class="badge bg-danger ms-2">
                                    <asp:Label ID="lblNotiApproval" runat="server"></asp:Label>
                                </span>

                            </a>
                        </li>


                        <!-- Notification 2 -->
                        <li>
                            <a class="dropdown-item py-2"
                               href="<%= ResolveUrl("~/lesen/pembatalan.aspx?p_Id=3351&m_Id=4351") %>">

                                <i class="bi bi-x-circle text-danger me-2"></i>
                                Kelulusan - Pembatalan

                                <span class="badge bg-danger ms-2">
                                    <asp:Label ID="lblNotiApproval2" runat="server"></asp:Label>
                                </span>

                            </a>
                        </li>


                        <!-- Notification 3 -->
                        <li id="divNotiSuratMohonUlasan" runat="server" visible="false">

                            <a class="dropdown-item py-2"
                               href="<%= ResolveUrl("~/lesen/semakansurat.aspx?p_Id=3351&m_Id=4353") %>">

                                <i class="bi bi-envelope-check text-warning me-2"></i>
                                Surat Mohon Ulasan

                                <span class="badge bg-danger ms-2">
                                    <asp:Label ID="lblNotiApproval3" runat="server"></asp:Label>
                                </span>

                            </a>

                        </li>


                        <li>
                            <hr class="dropdown-divider">
                        </li>


                        <!-- Logout -->
                        <li>
                            <a class="dropdown-item py-2 text-danger"
                               href='<%= ResolveUrl("~/logout") %>'>

                                <i class="bi bi-box-arrow-right me-2"></i>
                                Log Keluar

                            </a>
                        </li>

                    </ul>

                </div>
                <% End If %>

            </div>
        </div>
        </nav>

        <%--POPUP PAUTAN PANTAS--%>
        <style>
          /* ===== Popup Pautan Pantas - dua panel (gaya sama Hubungi Kami) ===== */
          #modalPautanPantas .modal-dialog { max-width:900px; }
          #modalPautanPantas .modal-content { border:0; border-radius:18px; overflow:hidden; box-shadow:0 24px 60px rgba(15,23,42,.28); }
          /* !important: master ada ".modal-body { padding:0 !important }" */
          #modalPautanPantas .modal-body { padding:0 !important; background:#fff; }
          #modalPautanPantas .pl-wrap { position:relative; display:grid; grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr); }

          #modalPautanPantas .pl-side { position:relative; overflow:hidden; background:linear-gradient(160deg,#23267a 0%,#2E3192 55%,#3b3fa8 100%); color:#fff; padding:26px 22px 22px; display:flex; flex-direction:column; gap:12px; }
          #modalPautanPantas .pl-side::after { content:""; position:absolute; right:-60px; bottom:-60px; width:180px; height:180px; border-radius:50%; background:rgba(255,255,255,.06); pointer-events:none; }
          #modalPautanPantas .pl-title { font-size:1.15rem; font-weight:700; display:flex; align-items:center; gap:9px; margin:0; }
          #modalPautanPantas .pl-sub { font-size:12.5px; color:#cfd2f5; margin:0; }
          #modalPautanPantas .pl-stat { position:relative; z-index:1; display:flex; align-items:center; gap:12px; padding:11px 12px; border-radius:12px;
                                        background:rgba(255,255,255,.09); border:1px solid rgba(255,255,255,.12); }
          #modalPautanPantas .pl-stat .ic { width:38px; height:38px; border-radius:10px; background:#fff; color:#2E3192; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
          #modalPautanPantas .pl-stat .k { font-size:11px; color:#cfd2f5; line-height:1.2; }
          #modalPautanPantas .pl-stat .v { font-size:13.5px; font-weight:700; line-height:1.3; }

          #modalPautanPantas .pl-main { padding:16px 20px 12px; }
          #modalPautanPantas .pl-close { position:absolute; top:12px; right:12px; z-index:2; }
          #modalPautanPantas .pl-head { font-size:11px; font-weight:800; color:#6c757d; letter-spacing:.06em; text-transform:uppercase; margin:4px 0 4px; display:flex; align-items:center; gap:7px; }
          #modalPautanPantas .pl-head i { color:#2E3192; font-size:13px; }
          #modalPautanPantas .pl-row { display:flex; align-items:center; gap:12px; padding:9px 8px; margin:0 -8px; border-radius:10px; border-bottom:1px solid #f1f3f5;
                                       text-decoration:none; color:inherit; transition:background .15s ease; }
          #modalPautanPantas .pl-row:last-of-type { border-bottom:0; }
          #modalPautanPantas .pl-row:hover { background:#F6F7FF; color:inherit; }
          #modalPautanPantas .pl-logo { width:40px; height:40px; border-radius:50%; background:#fff; border:1px solid #e6ecf6; padding:4px; flex-shrink:0;
                                        display:flex; align-items:center; justify-content:center; overflow:hidden; }
          #modalPautanPantas .pl-logo img { max-width:100%; max-height:100%; object-fit:contain; }
          #modalPautanPantas .pl-logo.pl-ic { border:0; font-size:19px; }
          #modalPautanPantas .pl-logo.pl-orange { background:#fde5c8; color:#c4670c; }
          #modalPautanPantas .pl-logo.pl-green { background:#d9f0e2; color:#2e7d4f; }
          #modalPautanPantas .pl-info { min-width:0; flex:1; }
          #modalPautanPantas .pl-name { font-size:14px; font-weight:700; color:#1f2937; line-height:1.25; }
          #modalPautanPantas .pl-desc { font-size:12px; color:#6c757d; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
          #modalPautanPantas .pl-btn { display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:600; padding:5px 11px; border-radius:999px;
                                       border:1px solid #dbe0ea; background:#fff; color:#344054; white-space:nowrap; transition:all .15s ease; }
          #modalPautanPantas .pl-row:hover .pl-btn { background:#2E3192; border-color:#2E3192; color:#fff; }
          #modalPautanPantas .pl-note { font-size:12px; color:#6c757d; margin-top:8px; display:flex; align-items:center; gap:6px; }

          @media (max-width: 767.98px) {
            #modalPautanPantas .modal-dialog { margin:12px; }
            #modalPautanPantas .pl-wrap { grid-template-columns:1fr; }
            #modalPautanPantas .pl-side { padding:20px 16px 16px; }
            #modalPautanPantas .pl-side::after { display:none; }
            #modalPautanPantas .pl-main { padding:12px 16px 10px; }
            #modalPautanPantas .pl-close { top:14px; right:14px; filter:invert(1) grayscale(1) brightness(2); }
            #modalPautanPantas .pl-desc { white-space:normal; }
          }

          /* ===== Popup Hubungi Kami - dua panel: tindakan utama (kiri) + direktori bahagian (kanan) ===== */
          #modalHubungi .modal-dialog { max-width:860px; }
          #modalHubungi .modal-content { border:0; border-radius:18px; overflow:hidden; box-shadow:0 24px 60px rgba(15,23,42,.28); }
          /* !important: master ada ".modal-body { padding:0 !important }" */
          #modalHubungi .modal-body { padding:0 !important; background:#fff; }
          #modalHubungi .hk-wrap { position:relative; display:grid; grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr); }

          #modalHubungi .hk-side { position:relative; background:linear-gradient(160deg,#23267a 0%,#2E3192 55%,#3b3fa8 100%); color:#fff; padding:26px 22px 22px; display:flex; flex-direction:column; gap:10px; }
          #modalHubungi .hk-side::after { content:""; position:absolute; right:-60px; bottom:-60px; width:180px; height:180px; border-radius:50%; background:rgba(255,255,255,.06); pointer-events:none; }
          #modalHubungi .hk-title { font-size:1.15rem; font-weight:700; display:flex; align-items:center; gap:9px; margin:0; }
          #modalHubungi .hk-sub { font-size:12.5px; color:#cfd2f5; margin:0 0 8px; }
          #modalHubungi .hk-act { position:relative; z-index:1; display:flex; align-items:center; gap:12px; padding:11px 12px; border-radius:12px;
                                  background:rgba(255,255,255,.09); border:1px solid rgba(255,255,255,.12); color:#fff; text-decoration:none;
                                  transition:background .15s ease, transform .15s ease; }
          #modalHubungi .hk-act:hover { background:rgba(255,255,255,.17); color:#fff; transform:translateX(2px); }
          #modalHubungi .hk-act .ic { width:38px; height:38px; border-radius:10px; background:#fff; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
          #modalHubungi .hk-act .ic.tel { color:#2E3192; } #modalHubungi .hk-act .ic.wa { color:#128c3e; } #modalHubungi .hk-act .ic.mail { color:#b45309; }
          #modalHubungi .hk-act .k { font-size:11px; color:#cfd2f5; line-height:1.2; }
          #modalHubungi .hk-act .v { font-size:13.5px; font-weight:700; line-height:1.3; word-break:break-all; }
          #modalHubungi .hk-act .go { margin-left:auto; color:#cfd2f5; font-size:14px; }

          #modalHubungi .hk-main { padding:18px 20px 14px; }
          #modalHubungi .hk-close { position:absolute; top:12px; right:12px; z-index:2; }
          #modalHubungi .hk-dept { font-size:11px; font-weight:800; color:#6c757d; letter-spacing:.06em; text-transform:uppercase; margin:6px 0 4px; display:flex; align-items:center; gap:7px; }
          #modalHubungi .hk-dept i { color:#2E3192; font-size:13px; }
          #modalHubungi .hk-row { display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid #f1f3f5; }
          #modalHubungi .hk-row:last-of-type { border-bottom:0; }
          #modalHubungi .hk-row .ic { width:34px; height:34px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0; background:#EEF0FF; color:#2E3192; }
          #modalHubungi .hk-row .ic.mail { background:#FFF4E5; color:#b45309; }
          #modalHubungi .hk-row .info { min-width:0; flex:1; }
          #modalHubungi .hk-row .k { font-size:11.5px; color:#6c757d; }
          #modalHubungi .hk-row .v { font-size:14px; font-weight:700; color:#1f2937; overflow-wrap:anywhere; }
          #modalHubungi .hk-btn { display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:600; padding:5px 11px; border-radius:999px;
                                  border:1px solid #dbe0ea; background:#fff; color:#344054; text-decoration:none; white-space:nowrap; cursor:pointer; }
          #modalHubungi .hk-btn:hover { background:#EEF0FF; border-color:#c9cdf5; color:#2E3192; }
          #modalHubungi .hk-btn.done { background:#e6f4ea; border-color:#badbcc; color:#0f5132; }
          #modalHubungi .hk-note { font-size:12px; color:#6c757d; margin-top:10px; display:flex; align-items:center; gap:6px; }

          @media (max-width: 767.98px) {
            #modalHubungi .modal-dialog { margin:12px; }
            #modalHubungi .hk-wrap { grid-template-columns:1fr; }
            #modalHubungi .hk-side { padding:20px 16px 16px; }
            #modalHubungi .hk-side::after { display:none; }
            #modalHubungi .hk-main { padding:14px 16px 12px; }
            #modalHubungi .hk-row .v { font-size:13px; }
            #modalHubungi .hk-close { top:14px; right:14px; filter:invert(1) grayscale(1) brightness(2); }
          }
        </style>

        <div class="modal fade" id="modalPautanPantas" tabindex="-1" aria-labelledby="modalPautanPantasTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body">
                        <div class="pl-wrap">

                            <%-- Kiri: pengenalan --%>
                            <div class="pl-side">
                                <h5 class="pl-title" id="modalPautanPantasTitle"><i class="bi bi-lightning-charge-fill"></i>Pautan Pantas</h5>
                                <p class="pl-sub">Akses pantas ke sistem dan portal dalam talian yang berkaitan.</p>

                                <div class="pl-stat">
                                    <span class="ic"><i class="bi bi-grid-3x3-gap-fill"></i></span>
                                    <span><span class="k d-block">Sistem Majlis Perbandaran Kluang</span><span class="v d-block">7 sistem dalaman</span></span>
                                </div>
                                <div class="pl-stat">
                                    <span class="ic"><i class="bi bi-globe2"></i></span>
                                    <span><span class="k d-block">Portal Kerajaan</span><span class="v d-block">Negeri &amp; Persekutuan</span></span>
                                </div>
                                <div class="pl-stat">
                                    <span class="ic"><i class="bi bi-box-arrow-up-right"></i></span>
                                    <span><span class="k d-block">Paparan</span><span class="v d-block">Dibuka dalam tab baharu</span></span>
                                </div>
                            </div>

                            <%-- Kanan: senarai sistem --%>
                            <div class="pl-main">
                                <button type="button" class="btn-close pl-close" data-bs-dismiss="modal" aria-label="Tutup"></button>

                                <div class="pl-head"><i class="bi bi-building"></i>Sistem Majlis Perbandaran Kluang</div>
                                <div class="pl-group">
                                    <a class="pl-row" href="http://prolesen.mpkluang.gov.my/" target="_blank" rel="noopener">
                                        <span class="pl-logo"><img src="<%= ResolveUrl("~/images/pautan/prolesen.png") %>" alt="Pro-Lesen" /></span>
                                        <span class="pl-info"><span class="pl-name d-block">Pro-Lesen</span><span class="pl-desc d-block">Sistem permohonan dan pengurusan lesen</span></span>
                                        <span class="pl-btn">Buka <i class="bi bi-arrow-up-right"></i></span>
                                    </a>
                                    <a class="pl-row" href="http://esistem.mpkluang.gov.my/forbidden/insyst/lesen/Inspect/main/" target="_blank" rel="noopener">
                                        <span class="pl-logo pl-ic pl-orange"><i class="bi bi-clipboard2-check-fill"></i></span>
                                        <span class="pl-info"><span class="pl-name d-block">Inspect</span><span class="pl-desc d-block">Sistem pemeriksaan dan penguatkuasaan pelesenan</span></span>
                                        <span class="pl-btn">Buka <i class="bi bi-arrow-up-right"></i></span>
                                    </a>
                                    <a class="pl-row" href="http://esistem.mpkluang.gov.my/forbidden/insyst/lesen/iGreen/main/" target="_blank" rel="noopener">
                                        <span class="pl-logo pl-ic pl-green"><i class="bi bi-tree-fill"></i></span>
                                        <span class="pl-info"><span class="pl-name d-block">i-Green</span><span class="pl-desc d-block">Sistem pelesenan aktiviti alam sekitar dan berkaitan</span></span>
                                        <span class="pl-btn">Buka <i class="bi bi-arrow-up-right"></i></span>
                                    </a>
                                    <a class="pl-row" href="http://iperolehan.mpkluang.gov.my/Default.aspx" target="_blank" rel="noopener">
                                        <span class="pl-logo"><img src="<%= ResolveUrl("~/images/pautan/eperolehan.jpg") %>" alt="e-Perolehan" /></span>
                                        <span class="pl-info"><span class="pl-name d-block">e-Perolehan</span><span class="pl-desc d-block">Sistem perolehan &amp; tender MPK</span></span>
                                        <span class="pl-btn">Buka <i class="bi bi-arrow-up-right"></i></span>
                                    </a>
                                    <a class="pl-row" href="https://aplas.mpkluang.gov.my/site/home" target="_blank" rel="noopener">
                                        <span class="pl-logo"><img src="<%= ResolveUrl("~/images/pautan/aplas.jpg") %>" alt="A-Plas" /></span>
                                        <span class="pl-info"><span class="pl-name d-block">A-Plas</span><span class="pl-desc d-block">Sistem semakan kelulusan pelan</span></span>
                                        <span class="pl-btn">Buka <i class="bi bi-arrow-up-right"></i></span>
                                    </a>
                                    <a class="pl-row" href="http://esistem.mpkluang.gov.my/eJOB_MPKLUANG/" target="_blank" rel="noopener">
                                        <span class="pl-logo"><img src="<%= ResolveUrl("~/images/pautan/ejob.jpg") %>" alt="eJob" /></span>
                                        <span class="pl-info"><span class="pl-name d-block">eJob</span><span class="pl-desc d-block">Permohonan jawatan Majlis Perbandaran Kluang</span></span>
                                        <span class="pl-btn">Buka <i class="bi bi-arrow-up-right"></i></span>
                                    </a>
                                    <a class="pl-row" href="http://ehartampk.mpkluang.gov.my:83/user/login" target="_blank" rel="noopener">
                                        <span class="pl-logo"><img src="<%= ResolveUrl("~/images/pautan/eharta.jpg") %>" alt="eHarta" /></span>
                                        <span class="pl-info"><span class="pl-name d-block">eHarta</span><span class="pl-desc d-block">Sistem pengurusan harta MPK</span></span>
                                        <span class="pl-btn">Buka <i class="bi bi-arrow-up-right"></i></span>
                                    </a>
                                </div>

                                <div class="pl-head mt-3"><i class="bi bi-globe2"></i>Portal Kerajaan</div>
                                <div class="pl-group">
                                    <a class="pl-row" href="https://johor.ekhidmat.my/ekhidmat/" target="_blank" rel="noopener">
                                        <span class="pl-logo"><img src="<%= ResolveUrl("~/images/pautan/ekhidmat.jpg") %>" alt="eKhidmat Johor" /></span>
                                        <span class="pl-info"><span class="pl-name d-block">eKhidmat Johor</span><span class="pl-desc d-block">Perkhidmatan dalam talian Negeri Johor</span></span>
                                        <span class="pl-btn">Buka <i class="bi bi-arrow-up-right"></i></span>
                                    </a>
                                    <a class="pl-row" href="https://osc3plus.kpkt.gov.my/" target="_blank" rel="noopener">
                                        <span class="pl-logo"><img src="<%= ResolveUrl("~/images/pautan/osc3plus.jpg") %>" alt="OSC 3 Plus Online" /></span>
                                        <span class="pl-info"><span class="pl-name d-block">OSC Online</span><span class="pl-desc d-block">OSC 3 Plus - permohonan pembangunan</span></span>
