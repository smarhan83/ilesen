                                                <path d="M205 55 h14 M212 48 v14" />
                                                <path d="M215 120 h12 M221 114 v12" />
                                              </g>
                                              <circle cx="30" cy="115" r="4" fill="none" stroke="#c7d5e8" stroke-width="3"/>
                                              <circle cx="185" cy="80" r="2.5" fill="#c7d5e8"/>
                                              <circle cx="198" cy="145" r="2.5" fill="#c7d5e8"/>

                                              <!-- clipboard shadow -->
                                              <rect x="58" y="42" width="110" height="140" rx="12" fill="#e8edf5"/>

                                              <!-- clipboard body -->
                                              <rect x="52" y="36" width="110" height="140" rx="12" fill="#ffffff" stroke="#c7d5e8" stroke-width="3"/>

                                              <!-- clip at top -->
                                              <rect x="87" y="26" width="40" height="20" rx="6" fill="#3d5a80" stroke="#3d5a80" stroke-width="2"/>
                                              <circle cx="107" cy="36" r="5" fill="#ffffff"/>

                                              <!-- text lines -->
                                              <g stroke="#c7d5e8" stroke-width="6" stroke-linecap="round">
                                                <line x1="72" y1="70" x2="132" y2="70"/>
                                                <line x1="72" y1="86" x2="140" y2="86"/>
                                                <line x1="72" y1="102" x2="120" y2="102"/>
                                                <line x1="72" y1="118" x2="140" y2="118"/>
                                                <line x1="72" y1="134" x2="110" y2="134"/>
                                              </g>

                                              <!-- magnifying glass -->
                                              <circle cx="150" cy="130" r="32" fill="#eaf1fb" stroke="#3d5a80" stroke-width="6"/>
                                              <line x1="173" y1="153" x2="196" y2="176" stroke="#3d5a80" stroke-width="8" stroke-linecap="round"/>
                                            </svg>
                                        </div>
                                        <h5>Sila masukkan No. Kad Pengenalan atau No. Passport</h5>
                                        <p>Masukkan maklumat di atas dan klik butang 'Semak' untuk melihat senarai permohonan lesen anda.</p>
                                    </div>
                                </EmptyDataTemplate>
                                <Columns>
                                    <asp:BoundField HeaderText="Bil" DataField="RowNo" />
                                    <asp:TemplateField HeaderText="No. Permohonan">
                                        <ItemTemplate>
                                            <a class="link-rujukan">
                                                <%# Eval("Rujukan") %>
                                            </a>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:BoundField HeaderText="Jenis Lesen" DataField="JenisLesenDescList" />
                                    <asp:BoundField HeaderText="Tarikh Mohon"
                                        DataField="TarikhMohon"
                                        DataFormatString="{0:dd/MM/yyyy}"
                                        HtmlEncode="false" />
                                    <asp:TemplateField HeaderText="Status">
                                        <ItemTemplate>
                                            <span class='<%# GetStatusClass(Eval("StatusDesc").ToString()) %>'>
                                                <%# Eval("StatusDesc") %>
                                            </span>
                                        </ItemTemplate>
                                    </asp:TemplateField>
                                    <asp:TemplateField HeaderText="Tindakan">
                                        <ItemTemplate>
                                            <div class="tindakan-wrap">
                                                <asp:LinkButton ID="lnkCetak"
                                                    runat="server"
                                                    CssClass='<%# GetButtonClass(Eval("StatusDesc")) %>'
                                                    CommandArgument='<%# CType(Container, GridViewRow).RowIndex %>'
                                                    Visible='<%# Eval("StatusDesc").ToString() = "Diluluskan" Or Eval("StatusDesc").ToString() = "Ditolak" %>'
                                                    OnClick="lnkCetak_Click"><i class="bi bi-printer me-1"></i>Cetak Surat</asp:LinkButton>

                                                <%-- QR sepanduk/banting: hanya bila lulus & ada kod QR --%>
                                                <asp:PlaceHolder ID="phQrBtn" runat="server" Visible='<%# AdaQr(Eval("StatusDesc"), Eval("QrCount")) %>'>
                                                    <button type="button" class="qr-toggle" onclick="toggleQrPanel(this)" aria-expanded="false">
                                                        <i class="bi bi-qr-code"></i>QR Sepanduk (<%# Eval("QrCount") %>)<i class="bi bi-chevron-down qr-chev"></i>
                                                    </button>
                                                </asp:PlaceHolder>
                                            </div>

                                            <%-- Panel QR - dipindahkan oleh toggleQrPanel() ke baris penuh di bawah baris ini --%>
                                            <asp:PlaceHolder ID="phQrPanel" runat="server" Visible='<%# AdaQr(Eval("StatusDesc"), Eval("QrCount")) %>'>
                                                <div class="qr-panel-src" hidden>
                                                    <div class="qr-panel">
                                                        <div class="qr-panel-head">
                                                            <div>
                                                                <div class="qr-panel-title"><i class="bi bi-qr-code"></i>QR Sepanduk / Bunting</div>
                                                                <div class="qr-panel-sub">
                                                                    Tempoh pemasangan: <b><%# TempohBanting(Eval("TarikhBanting1"), Eval("TarikhBanting2")) %></b>
                                                                    &middot; <%# Eval("QrCount") %> kod QR
                                                                </div>
                                                            </div>
                                                            <a class="qr-btn qr-btn-primary" target="_blank" rel="noopener"
                                                                href='<%# ResolveUrl("~/CetakQRBanting.aspx?semua=1&id=" & HttpUtility.UrlEncode(Convert.ToString(Eval("QrFirstID")))) %>'>
                                                                <i class="bi bi-printer"></i>Cetak Semua QR
                                                            </a>
                                                        </div>

                                                        <asp:Repeater ID="rptQr" runat="server" DataSource='<%# If(AdaQr(Eval("StatusDesc"), Eval("QrCount")), GetBantingQr(Eval("Permohonan_ID")), Nothing) %>'>
                                                            <HeaderTemplate><div class="qr-grid"></HeaderTemplate>
                                                            <ItemTemplate>
                                                                <div class="qr-card">
                                                                    <img class="qr-img" loading="lazy" alt="Kod QR"
                                                                        src='<%# ResolveUrl("~/QrBanting.ashx?id=" & HttpUtility.UrlEncode(Convert.ToString(Eval("UniqueID")))) %>' />
                                                                    <div class="qr-info">
                                                                        <div class="qr-lokasi-no">Lokasi <%# Eval("LokasiNo") %></div>
                                                                        <div class="qr-lokasi"><%# HttpUtility.HtmlEncode(If(String.IsNullOrWhiteSpace(Convert.ToString(Eval("Lokasi"))), "-", Eval("Lokasi"))) %></div>
                                                                        <div class="qr-kod"><%# HttpUtility.HtmlEncode(Eval("UniqueID")) %></div>
                                                                        <div class="qr-actions">
                                                                            <a class="qr-btn" data-no-loader="1" download='<%# "QR-" & HttpUtility.HtmlAttributeEncode(Convert.ToString(Eval("UniqueID"))) & ".png" %>'
                                                                                href='<%# ResolveUrl("~/QrBanting.ashx?dl=1&id=" & HttpUtility.UrlEncode(Convert.ToString(Eval("UniqueID")))) %>'>
                                                                                <i class="bi bi-download"></i>Muat Turun
                                                                            </a>
                                                                            <a class="qr-btn" target="_blank" rel="noopener"
                                                                                href='<%# ResolveUrl("~/CetakQRBanting.aspx?id=" & HttpUtility.UrlEncode(Convert.ToString(Eval("UniqueID")))) %>'>
                                                                                <i class="bi bi-printer"></i>Cetak
                                                                            </a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </ItemTemplate>
                                                            <FooterTemplate></div></FooterTemplate>
                                                        </asp:Repeater>
                                                    </div>
                                                </div>
                                            </asp:PlaceHolder>
                                        </ItemTemplate>
                                    </asp:TemplateField>
<%--                                    <asp:TemplateField HeaderText="Tindakan">
                                        <ItemTemplate>
                                            <%# GetActionButton(Eval("StatusDesc"), Eval("Permohonan_ID")) %>
                                        </ItemTemplate>
                                    </asp:TemplateField>--%>
                                </Columns>
                            </asp:GridView>                        

                            <asp:SqlDataSource ID="SqlDataSourceGrid" runat="server"
                                ConnectionString="<%$ ConnectionStrings:webcon_ConnectionStr %>"
                                SelectCommand="SELECT 

                                ROW_NUMBER() OVER(ORDER BY g.TarikhMohon desc, g.Permohonan_ID desc) as RowNo,
                                    CASE
                                        WHEN g.StatusID = 10 THEN 'Diluluskan'
                                        WHEN g.StatusID IN (6,9) THEN 'Ditolak'
                                        ELSE 'Dalam Semakan'
                                    END AS StatusDesc,
                                '' AS UserType, g.Permohonan_ID, g.JenisLesen_ID, g.TarikhMohon, g.JenisLesenDescList, g.Rujukan,
                                g.IsSuratKelulusanFail, g.StatusID, g.IsPublish, g.Is24jam, f.Pemohon_Name,
                                g.TarikhBanting1, g.TarikhBanting2,
                                /* Kod QR sepanduk/banting (LESEN_BantingImej) - satu kod bagi setiap gambar di setiap lokasi */
                                (SELECT COUNT(*) FROM LESEN_BantingImej bi WHERE bi.Permohonan_ID = g.Permohonan_ID) AS QrCount,
                                (SELECT TOP 1 bi.UniqueID FROM LESEN_BantingImej bi WHERE bi.Permohonan_ID = g.Permohonan_ID ORDER BY bi.Lokasi_ID, bi.Imej_ID) AS QrFirstID
                                /* Ambil terus dari LESEN_Permohonan: Permit Sepanduk/Bunting (27) terus lulus (StatusID=10)
                                   tanpa rekod LESEN_ApprovalList, jadi tiada dalam v_LESEN_ApprovalList_Curr */
                                FROM LESEN_Permohonan g
                                    inner join LESEN_Pemohon f on f.Pemohon_ID = g.Permohonan_PemohonID
                                    WHERE g.StatusID &gt; 0
                                    and g.IsBatal = 0
                                    and g.JenisLesen_ID = 0
                                    and (
                                        REPLACE(REPLACE(REPLACE(f.Pemohon_ICNo, '-', ''), ' ', ''), CHAR(9), '') =
                                        REPLACE(REPLACE(REPLACE(@Pemohon_ICNo, '-', ''), ' ', ''), CHAR(9), '')
                                        or
                                        REPLACE(REPLACE(REPLACE(f.Pemohon_PassportNo, '-', ''), ' ', ''), CHAR(9), '') =
                                        REPLACE(REPLACE(REPLACE(@Pemohon_ICNo, '-', ''), ' ', ''), CHAR(9), '')
                                        or
                                        REPLACE(REPLACE(REPLACE(g.NoPendaftaran, '-', ''), ' ', ''), CHAR(9), '') like
                                        '%'+REPLACE(REPLACE(REPLACE(@Pemohon_ICNo, '-', ''), ' ', ''), CHAR(9), '')+'%'
                                    )
                                order by g.TarikhMohon desc, g.Permohonan_ID desc"
                                >

                                <SelectParameters>                                  

                                    <asp:ControlParameter ControlID="txtNoPengenalan" PropertyName="Text" DefaultValue="" Name="Pemohon_ICNo"></asp:ControlParameter>                                                                        

                                </SelectParameters>
                            </asp:SqlDataSource>

                            <div class="alert alert-info-custom mt-3">
                                <i class="bi bi-info-circle-fill info-icon"></i>
                                <div class="info-content">
                                    <strong>Maklumat</strong>
                                    <p>Bagi permohonan yang telah diluluskan atau ditolak, klik butang <b>Cetak Surat</b> untuk memuat turun surat rasmi.
                                        Bagi permit sepanduk / bunting yang diluluskan, klik <b>QR Sepanduk</b> untuk memuat turun dan mencetak kod QR bagi setiap lokasi.</p>
                                </div>
                            </div>

                            </div>


                    </div>


                </div>

            </div>

        </div>


      <!-- =======================
           HOMEPAGE (Public)
      ======================== -->
        <%  If CInt(Session.Item("sessionUsersId")) = 0 Then %>

        <main id="homePage">
    <section class="hero">
      <div class="container">
        <section class="hero">
		  <div class="container">
			<div class="hero-slider hero-curve" id="heroSlider">

			  <!-- Slide 1 -->
			  <div class="hero-slide active hero-clip"
				   style="background-image:url('https://images.unsplash.com/photo-1521791055366-0d553872125f?auto=format&fit=crop&w=1800&q=80');">
				<div class="hero-info hero-info-curve">
				  <span class="badge-soft"><i class="bi bi-shield-check me-1"></i>Selamat & Terurus</span>
				  <h1>Permohonan Lesen Lebih Pantas</h1>
				  <p>
					ProLesen membantu pengguna memohon, menyemak status dan mengurus lesen
					dengan lebih mudah secara digital - mesra pengguna & responsif.
				  </p>
				  <div class="hero-actions">
					<button class="btn btn-hero" id="btnQuickLogin1"><i class="bi bi-person-lock me-1"></i>Log Masuk</button>
					<button class="btn btn-hero"><i class="bi bi-info-circle me-1"></i>Ketahui Lebih Lanjut</button>
				  </div>
				</div>
			  </div>

			  <!-- Slide 2 -->
			  <div class="hero-slide hero-clip"
				   style="background-image:url('https://images.unsplash.com/photo-1556761175-4b46a572b786?auto=format&fit=crop&w=1800&q=80');">
				<div class="hero-info hero-info-curve">
				  <span class="badge-soft"><i class="bi bi-people me-1"></i>Mesra Agensi</span>
				  <h1>Urus Kelulusan & Semakan</h1>
				  <p>
					Modul agensi & jabatan memudahkan semakan, kelulusan dan pemantauan
					permohonan lesen dengan rekod yang teratur.
				  </p>
				  <div class="hero-actions">
					<button class="btn btn-hero"><i class="bi bi-journal-text me-1"></i>Manual Agensi</button>
					<button type="button" class="btn btn-hero" data-bs-toggle="modal" data-bs-target="#modalPautanPantas"><i class="bi bi-lightning-charge me-1"></i>Pautan Pantas</button>
				  </div>
				</div>
			  </div>

			  <!-- Slide 3 -->
			  <div class="hero-slide hero-clip"
				   style="background-image:url('https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1800&q=80');">
				<div class="hero-info hero-info-curve">
				  <span class="badge-soft"><i class="bi bi-graph-up-arrow me-1"></i>Dashboard & Laporan</span>
				  <h1>Analitik & Laporan Korporat</h1>
				  <p>
					Dapatkan ringkasan permohonan, prestasi proses dan laporan untuk
					pengurusan dengan paparan moden dan kemas.
				  </p>
				  <div class="hero-actions">
					<button class="btn btn-hero"><i class="bi bi-bar-chart me-1"></i>Lihat Contoh</button>
					<button type="button" class="btn btn-hero" data-bs-toggle="modal" data-bs-target="#modalHubungi"><i class="bi bi-telephone me-1"></i>Hubungi Kami</button>
				  </div>
				</div>
			  </div>

			  <!-- Curve overlay bawah (wave) -->
			  <div class="hero-wave">
				<svg viewBox="0 0 1440 140" preserveAspectRatio="none">
					<path
					  d="M0,64 C240,140 420,10 720,70 C980,130 1120,40 1440,95 L1440,140 L0,140 Z"
					  fill="rgba(17,24,39,0.22)">
					</path>

				</svg>
			  </div>

			  <div class="slider-dots" id="sliderDots"></div>
			</div>
		  </div>
		</section>


        </div>
      </div>
    </section>

    <section class="py-4">
      <div class="container">
        <div class="row g-4">

          <div class="col-lg-4">
            <div class="soft-card p-4 h-100">
              <div class="d-flex align-items-start gap-3">
                <div class="feature-icon">
                  <i class="bi bi-file-earmark-text"></i>
                </div>
                <div>
                  <div class="section-title">Permohonan Berstruktur</div>
                  <p class="section-subtitle">
                    Borang permohonan direka kemas & mudah diisi untuk pengguna awam.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="soft-card p-4 h-100">
              <div class="d-flex align-items-start gap-3">
                <div class="feature-icon">
                  <i class="bi bi-clock-history"></i>
                </div>
                <div>
                  <div class="section-title">Jejak Status Permohonan</div>
                  <p class="section-subtitle">
                    Semak status secara real-time untuk kelulusan, semakan & tindakan.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="soft-card p-4 h-100">
              <div class="d-flex align-items-start gap-3">
                <div class="feature-icon">
                  <i class="bi bi-shield-lock"></i>
                </div>
                <div>
                  <div class="section-title">Keselamatan & Akses</div>
                  <p class="section-subtitle">
                    Kawalan akses pengguna mengikut peranan (role) untuk admin & agensi.
                  </p>
                </div>
              </div>
            </div>
          </div>

        </div>

        <style>
          /* ---------- Sistem Pelesenan Berkaitan ---------- */
          .sys-head { display:flex; align-items:center; gap:14px; margin-bottom:18px; }
          .sys-head-icon { width:44px; height:44px; border-radius:12px; background:#eef4ff; color:#2563eb;
                           display:flex; align-items:center; justify-content:center; font-size:22px; flex-shrink:0; }
          .sys-head h3 { font-size:20px; font-weight:800; color:#1e293b; margin:0; }
          .sys-head p { margin:2px 0 0; color:#64748b; font-size:14px; }

          .sys-tile { position:relative; overflow:hidden; height:100%; border-radius:14px; padding:20px;
                      border:1px solid var(--sys-border); background:var(--sys-bg);
                      display:flex; flex-direction:column; transition:transform .15s ease, box-shadow .15s ease; }
          .sys-tile:hover { transform:translateY(-2px); box-shadow:0 10px 24px rgba(15,23,42,.08); }
          .sys-tile .sys-bg-icon { position:absolute; right:-10px; top:-6px; font-size:96px; color:var(--sys-color);
                                   opacity:.08; pointer-events:none; }
          .sys-tile .sys-icon { width:56px; height:56px; border-radius:50%; background:var(--sys-soft); color:var(--sys-color);
                                display:flex; align-items:center; justify-content:center; font-size:26px; margin-bottom:12px; }
          .sys-tile h4 { font-size:22px; font-weight:800; color:var(--sys-dark); margin:0 0 4px; }
          .sys-tile p { color:#475569; font-size:14px; margin:0 0 16px; flex-grow:1; }
          .sys-tile .sys-actions { display:flex; align-items:center; justify-content:space-between; gap:10px; }
          .sys-tile .btn-sys { background:var(--sys-color); color:#fff; border:0; border-radius:10px; font-weight:700;
                               padding:9px 18px; display:inline-flex; align-items:center; gap:8px; text-decoration:none; flex-grow:1; justify-content:center; }
          .sys-tile .btn-sys:hover { filter:brightness(.92); color:#fff; }
          .sys-tile .sys-chevron { color:var(--sys-dark); font-size:18px; text-decoration:none; }

          .sys-green  { --sys-color:#2e7d4f; --sys-dark:#1f5c39; --sys-soft:#d9f0e2; --sys-bg:#f3faf6; --sys-border:#e1f1e7; }
          .sys-orange { --sys-color:#c4670c; --sys-dark:#7a3f06; --sys-soft:#fde5c8; --sys-bg:#fff8ef; --sys-border:#fbead4; }
          .sys-blue   { --sys-color:#2563eb; --sys-dark:#1e3a8a; --sys-soft:#dbe7fd; --sys-bg:#f3f7ff; --sys-border:#e1eafb; }

          /* ---------- Akses Pantas ---------- */
          .qa-link { display:flex; align-items:center; gap:12px; width:100%; padding:12px 16px; border-radius:10px;
                     border:1px solid #dbe4f3; background:#f5f8fe; color:#1e3a8a; font-weight:700; text-decoration:none;
                     transition:background .15s ease; }
          .qa-link:hover { background:#e8effc; color:#1e3a8a; }
          .qa-link i:first-child { font-size:18px; color:#2563eb; }
          .qa-link .qa-chevron { margin-left:auto; color:#1e3a8a; }

          /* ---------- Pengumuman ---------- */
          .ann-item { display:flex; gap:12px; height:100%; }
          .ann-item .ann-dot { width:8px; height:8px; border-radius:50%; background:#2563eb; margin-top:7px; flex-shrink:0; }
          .ann-item strong { color:#1e293b; }
          @media (min-width: 992px) {
            .ann-col + .ann-col { border-left:1px solid #e2e8f0; }
          }
        </style>

        <div class="row g-4 mt-1">

          <!-- Sistem Pelesenan Berkaitan -->
          <div class="col-lg-8">
            <div class="soft-card p-4 h-100">
              <div class="sys-head">
                <div class="sys-head-icon"><i class="bi bi-grid-fill"></i></div>
                <div>
                  <h3>Sistem Pelesenan Berkaitan</h3>
                  <p>Akses pantas kepada sistem pelesenan Majlis Perbandaran Kluang.</p>
                </div>
              </div>

              <div class="row g-3">
                <div class="col-md-4">
                  <div class="sys-tile sys-green">
                    <i class="bi bi-tree-fill sys-bg-icon"></i>
                    <div class="sys-icon"><i class="bi bi-tree-fill"></i></div>
                    <h4>i-Green</h4>
                    <p>Sistem pelesenan aktiviti alam sekitar dan berkaitan.</p>
                    <div class="sys-actions">
                      <a class="btn-sys" href="http://esistem.mpkluang.gov.my/forbidden/insyst/lesen/iGreen/main/" target="_blank" rel="noopener">
                        Buka Sistem <i class="bi bi-box-arrow-up-right"></i>
                      </a>
                      <a class="sys-chevron" href="http://esistem.mpkluang.gov.my/forbidden/insyst/lesen/iGreen/main/" target="_blank" rel="noopener" aria-label="Buka i-Green">
                        <i class="bi bi-chevron-right"></i>
                      </a>
                    </div>
                  </div>
                </div>

                <div class="col-md-4">
                  <div class="sys-tile sys-orange">
                    <i class="bi bi-clipboard2-check-fill sys-bg-icon"></i>
                    <div class="sys-icon"><i class="bi bi-clipboard2-check-fill"></i></div>
                    <h4>Inspect</h4>
                    <p>Sistem pemeriksaan dan penguatkuasaan pelesenan.</p>
                    <div class="sys-actions">
                      <a class="btn-sys" href="http://esistem.mpkluang.gov.my/forbidden/insyst/lesen/Inspect/main/" target="_blank" rel="noopener">
                        Buka Sistem <i class="bi bi-box-arrow-up-right"></i>
                      </a>
                      <a class="sys-chevron" href="http://esistem.mpkluang.gov.my/forbidden/insyst/lesen/Inspect/main/" target="_blank" rel="noopener" aria-label="Buka Inspect">
                        <i class="bi bi-chevron-right"></i>
                      </a>
                    </div>
                  </div>
                </div>

                <div class="col-md-4">
                  <div class="sys-tile sys-blue">
                    <i class="bi bi-file-earmark-text-fill sys-bg-icon"></i>
                    <div class="sys-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                    <h4>ProLesen</h4>
                    <p>Sistem permohonan dan pengurusan lesen.</p>
                    <div class="sys-actions">
                      <a class="btn-sys" href="http://prolesen.mpkluang.gov.my/" target="_blank" rel="noopener">
                        Buka Sistem <i class="bi bi-box-arrow-up-right"></i>
                      </a>
                      <a class="sys-chevron" href="http://prolesen.mpkluang.gov.my/" target="_blank" rel="noopener" aria-label="Buka ProLesen">
                        <i class="bi bi-chevron-right"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Akses Pantas -->
          <div class="col-lg-4">
            <div class="soft-card p-4 h-100">
              <div class="sys-head">
                <div class="sys-head-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                <div>
                  <div class="section-title mb-0">Akses Pantas</div>
                  <p>Pautan yang kerap digunakan</p>
                </div>
              </div>

              <div class="d-grid gap-2">
                <asp:LinkButton ID="LinkButton1"
                    runat="server"
                    CssClass="qa-link"
                    OnClick="lnkSemak_Click">
                    <i class="bi bi-file-earmark-text"></i>
                    Semak Permohonan
                    <i class="bi bi-chevron-right qa-chevron"></i>
                </asp:LinkButton>
                <a class="qa-link" href="#"><i class="bi bi-book"></i>Manual Agensi &amp; Jabatan<i class="bi bi-chevron-right qa-chevron"></i></a>
                <a class="qa-link" href="#" data-bs-toggle="modal" data-bs-target="#modalPautanPantas"><i class="bi bi-lightning-charge"></i>Pautan Pantas<i class="bi bi-chevron-right qa-chevron"></i></a>
                <a class="qa-link" href="#" data-bs-toggle="modal" data-bs-target="#modalHubungi"><i class="bi bi-telephone-fill"></i>Hubungi Kami<i class="bi bi-chevron-right qa-chevron"></i></a>
              </div>
            </div>
          </div>

          <!-- Pengumuman & Makluman -->
          <div class="col-12">
            <div class="soft-card p-4">
              <div class="sys-head">
                <div class="sys-head-icon"><i class="bi bi-megaphone"></i></div>
                <div>
                  <div class="section-title mb-0">Pengumuman &amp; Makluman</div>
                  <p>Makluman penting berkaitan proses permohonan lesen dan kemaskini sistem.</p>
                </div>
              </div>

              <div class="row g-3">
                <div class="col-lg-4 ann-col">
                  <div class="ann-item">
                    <span class="ann-dot"></span>
                    <div>
                      <strong>Waktu Operasi Kaunter</strong>
                      <div class="text-muted small">Isnin hingga Jumaat, 8.00 pagi - 5.00 petang</div>
                    </div>
                  </div>
                </div>
                <div class="col-lg-4 ann-col">
                  <div class="ann-item">
                    <span class="ann-dot"></span>
                    <div>
                      <strong>Dokumen Sokongan</strong>
                      <div class="text-muted small">Sila pastikan dokumen lengkap sebelum hantar permohonan</div>
                    </div>
                  </div>
                </div>
                <div class="col-lg-4 ann-col">
                  <div class="ann-item">
                    <span class="ann-dot"></span>
                    <div>
                      <strong>Sokongan Pengguna</strong>
                      <div class="text-muted small">Gunakan menu Hubungi Kami untuk bantuan teknikal</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>


  </main>

            <!-- START LOGIN BOX -->

			<!-- Login Section -->
            <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-lg">

                <div class="modal-content border-0 shadow-lg">

                    <div class="modal-body p-0">


                           
                    <div class="row g-0">

                 

                      <!-- Right Side - Login Form -->
                      <div class="col-lg-7 p-5 bg-white">


                        <!-- Login Form -->
                        <asp:Panel ID="myForm" runat="server" DefaultButton="btnLogin">

                        <div class="mb-4">
                          <h1 class="mb-2" style="font-size: 28px; font-weight: 900; color: var(--text);">Log Masuk</h1>
                          <p class="text-muted mb-4">Sila masukkan maklumat akaun anda</p>

                        </div>
              
                          <!-- ID Pengguna Field -->
                          <div class="mb-3">
                            <label for="txtUsername" class="form-label" style="font-weight: 600;">ID Pengguna</label>

                            <div class="modern-input">
                                <i class="bi bi-person-circle input-icon"></i>

                                <asp:TextBox
                                    ID="txtUsername"
                                    runat="server"
                                    CssClass="form-control custom-input"
                                    placeholder="Cth: 910101014321 (tanpa '-')">
                                </asp:TextBox>
                            </div>
                            <asp:RequiredFieldValidator ID="RequiredFieldValidator3" runat="server"
                                                       ValidationGroup="loginForm"
                                                       ControlToValidate="txtUsername" 
                                                       ErrorMessage="Sila masukkan ID Pengguna" 
                                                       Display="Dynamic"
                                                       CssClass="text-danger small mt-1"></asp:RequiredFieldValidator>
                            <%--<asp:ValidatorCalloutExtender ID="ce1" runat="server" TargetControlID="RequiredFieldValidator3">
                            </asp:ValidatorCalloutExtender>--%>
                          </div>

                          <!-- Password Field -->
                          <div class="mb-3">
                            <label for="txtPassword" class="form-label" style="font-weight: 600;">Katalaluan</label>
                            <div class="modern-input">
                                <i class="bi bi-lock-fill input-icon"></i>

                                <asp:TextBox
                                    ID="txtPassword"
                                    runat="server"
                                    TextMode="Password"
                                    CssClass="form-control custom-input"
                                    placeholder="Masukkan katalaluan anda">
                                </asp:TextBox>

                                <button type="button" id="togglePassword" class="eye-btn">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <asp:RequiredFieldValidator ID="RequiredFieldValidator2" runat="server"
                                                       ValidationGroup="loginForm"
                                                       ControlToValidate="txtPassword" 
                                                       ErrorMessage="Sila masukkan katalaluan" 
                                                       Display="Dynamic"
                                                       CssClass="text-danger small mt-1"></asp:RequiredFieldValidator>
                            <%--<asp:ValidatorCalloutExtender ID="ce2" runat="server" TargetControlID="RequiredFieldValidator2">
                            </asp:ValidatorCalloutExtender>--%>
                          </div>

                          <!-- Remember Me & Forgot Password -->
                          <div class="d-flex justify-content-between align-items-center mb-4">
                            <%--<div class="form-check">
                              <input class="form-check-input" type="checkbox" id="rememberMe">
                              <label class="form-check-label text-muted" for="rememberMe" style="font-size: 13px;">
                                Ingat Saya
                              </label>
                            </div>--%>
                            <asp:LinkButton ID="lbFP" runat="server" CssClass="btn btn-link p-0" 
                                           style="color: var(--primary); text-decoration: none; font-weight: 600; font-size: 13px;">
                              Lupa Katalaluan?
                            </asp:LinkButton>
                          </div>

                          <!-- Login Button -->
                          <asp:Button ID="btnLogin" runat="server" Text="Log Masuk"
                                    ValidationGroup="loginForm"
                                     CssClass="btn btn-outline-primary w-100 mb-2" 
                                     Style="padding: 10px; font-weight: 700; border-radius: 8px;" />

              
                          <!-- Error Message -->
                      <%--  <asp:Label ID="txtError"
                            runat="server"
                            CssClass="alert alert-danger d-block mb-4"
                            Visible="false">
                        </asp:Label>--%>

                        <div class="text-center mb-3">
                        <asp:Label ID="txtError" runat="server" Text="" 
                                    CssClass="alert alert-danger d-inline-block px-3 py-2" 
                                    Style="display: none; font-size: 13px;" Visible="false"></asp:Label>
                        </div>

                        </asp:Panel>

                        <!-- Forgot Password Form (Hidden by default) -->
                        <div runat="server" id="myCheckAcc" visible="false" class="fade-in">
                          <div class="mb-4">
                            <%--<button type="button" class="btn btn-link p-0 mb-4" id="backToLogin" 
                                   style="color: var(--primary); font-weight: 600;">
                              <i class="bi bi-arrow-left me-1"></i>Kembali ke Log Masuk
                            </button>--%>
                            <h1 class="mb-2" style="font-size: 24px; font-weight: 900;">Pengesahan Akaun</h1>
                            <p class="text-muted mb-4">Masukkan alamat email anda untuk memulihkan akaun</p>
                          </div>

                          <asp:FormView ID="fvFP" DefaultMode="Insert" Width="100%" runat="server" 
                                       DataKeyNames="farmerID" DataSourceID="SqlDataSourceForm">
                            <InsertItemTemplate>
                  
                              <!-- Email Field -->
                              <div class="mb-3">
                                <label for="Users_Email" class="form-label" style="font-weight: 600;">Alamat Email</label>
                                 <div class="modern-input">
                                    <i class="bi bi-envelope input-icon"></i>

                                    <asp:TextBox 
                                        AutoCompleteType="Disabled"
                                        ID="Users_Email"
                                        runat="server"
                                        CssClass="form-control custom-input"
                                        placeholder="Masukkan alamat email anda"
                                        aria-label="Alamat Email">
                                    </asp:TextBox>
                                </div>
                                <asp:RequiredFieldValidator ID="RequiredFieldValidator5" ControlToValidate="Users_Email" 
                                                           CssClass="text-danger small" runat="server" 
                                                           ErrorMessage="Sila masukkan alamat email!" 
                                                           ValidationGroup="insertForm" Display="Dynamic"></asp:RequiredFieldValidator>
                                <asp:RegularExpressionValidator ID="RegularExpressionValidator1" runat="server" 
                                                               CssClass="text-danger small"
                                                               ControlToValidate="Users_Email" 
                                                               ErrorMessage="Format email tidak sah"
                                                               ValidationExpression="\w+([-+.']\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*"
                                                               ValidationGroup="insertForm" Display="Dynamic"></asp:RegularExpressionValidator>
                              </div>

                              <!-- Check Account Button -->
                              <asp:LinkButton ID="btnCheckAcc" runat="server" Text="Semak Akaun" 
                                             CssClass="btn btn-outline-primary w-100 mb-2"  
                                             Style="padding: 10px; font-weight: 700; border-radius: 8px;" 
                                             ValidationGroup="insertForm" CausesValidation="True" 
                                             OnClick="btnCheckAcc_Click"></asp:LinkButton>

                              <!-- Status Message -->
                              <div class="text-center mb-3">
                                <asp:Label ID="lblCheckAcc" runat="server" Text="" 
                                          CssClass="alert alert-info d-inline-block px-3 py-2" 
                                          Style="display: none; font-size: 13px;" Visible="false"></asp:Label>
                              </div>

                              <asp:HiddenField ID="hfRegID" runat="server" />

                              <!-- Email Verify Button -->
                              <asp:LinkButton ID="btnEmailVerify" Visible="false" runat="server" 
                                             Text="Hantar Semula Pautan Pengesahan" 
                                             CssClass="btn btn-outline-primary w-100 mb-2" 
                                             Style="padding: 10px; font-weight: 600; border-radius: 8px;" 
                                             ValidationGroup="insertForm" CausesValidation="True" 
                                             OnClick="btnEmailVerify_Click"></asp:LinkButton>

                              <!-- Email Reset Button -->
                              <asp:LinkButton ID="btnEmailReset" Visible="false" runat="server" 
                                             Text="Set Semula Katalaluan" 
                                             CssClass="btn btn-outline-primary w-100 mb-2" 
                                             Style="padding: 10px; font-weight: 700; border-radius: 8px;" 
                                             ValidationGroup="insertForm" CausesValidation="True" 
                                             OnClick="btnEmailReset_Click"></asp:LinkButton>

                                <asp:LinkButton 
                                    ID="btnBackLogin" 
                                    runat="server"
                                    Text="&larr; Login Semula"
                                    CssClass="btn btn-link w-100"
                                    OnClick="btnBackLogin_Click"
                                    Style="font-weight:600; text-decoration:none;">
                                </asp:LinkButton>

                            </InsertItemTemplate>
                          </asp:FormView>

                          <asp:SqlDataSource runat="server" ID="SqlDataSourceForm" 
                                            ConnectionString='<%$ ConnectionStrings:webcon_ConnectionStr %>'
                                            InsertCommand="INSERT INTO TBL_USERS (Users_Name, Users_Fullname, Users_Password, Users_Email, Users_Enabled, Users_Register,Users_TelNo,Users_RegID,createdDate,estate_id,Users_Address) 
                                            VALUES (@Users_Email, @Users_Fullname, @Users_Password, @Users_Email, 0, 0,@Users_TelNo,@Users_RegID,getdate(),0,@Users_Address);
                                            SELECT @latestID = @@IDENTITY;
                                            INSERT INTO ECM_Buyers (Username,FullName,Email,Active,CreatorID,CreatedDt,LastModID,LastModDt,PhoneNo,UsersID)
                                            VALUES (@Users_Email,@Users_Fullname,@Users_Email,0,'regform',getdate(),'regform',getdate(),@Users_TelNo,@latestID);
                                            INSERT INTO TBL_USER_GROUPLIST (UGL_UGN_Id,UGL_Users_Id) VALUES (8,@latestID);">
                            <InsertParameters>
                              <asp:Parameter Name="latestID" Type="Int32" Direction="Output" />  
                              <asp:Parameter Name="Users_Name" />
