        <script>
            // Salin teks ke clipboard (fallback untuk pelayar / sambungan tanpa HTTPS)
            function hkCopy(btn, text) {
                function done() {
                    var old = btn.innerHTML;
                    btn.classList.add('done'); btn.innerHTML = '<i class="bi bi-check2"></i>Disalin';
                    setTimeout(function () { btn.classList.remove('done'); btn.innerHTML = old; }, 1600);
                }
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text).then(done);
                } else {
                    var ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
                    document.body.appendChild(ta); ta.select();
                    try { document.execCommand('copy'); done(); } catch (e) { }
                    document.body.removeChild(ta);
                }
            }
        </script>

        <%--POPUP SEMAKAN--%>
        <style>
            /* ===== QR Sepanduk / Bunting dalam modal Semakan Status ===== */
            #modalSemak .tindakan-wrap { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
            #modalSemak .qr-toggle {
                display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 6px;
                border: 1px solid #2E3192; background: #fff; color: #2E3192;
                font-weight: 600; font-size: 11.5px; line-height: 1.4; cursor: pointer;
            }
            #modalSemak .qr-toggle:hover, #modalSemak .qr-toggle.open { background: #2E3192; color: #fff; }
            #modalSemak .qr-chev { transition: transform .2s ease; font-size: 10px; }
            #modalSemak .qr-toggle.open .qr-chev { transform: rotate(180deg); }

            #modalSemak tr.qr-detail-row > td { background: #f8f9fc !important; padding: 0 !important; }
            #modalSemak .qr-panel { padding: 16px 18px; border-left: 3px solid #2E3192; }
            #modalSemak .qr-panel-head { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-bottom: 14px; }
            #modalSemak .qr-panel-title { font-weight: 700; color: #2E3192; font-size: 14px; display: flex; align-items: center; gap: 8px; }
            #modalSemak .qr-panel-sub { color: #6c757d; font-size: 12.5px; margin-top: 2px; }
            #modalSemak .qr-panel-sub b { color: #343a40; }

            #modalSemak .qr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
            #modalSemak .qr-card {
                display: flex; gap: 12px; align-items: center; background: #fff;
                border: 1px solid #e3e7ef; border-radius: 10px; padding: 12px;
            }
            #modalSemak .qr-img { width: 96px; height: 96px; flex-shrink: 0; border: 1px solid #eef0f4; border-radius: 6px; image-rendering: pixelated; background: #fff; }
            #modalSemak .qr-panel, #modalSemak .qr-info { text-align: left; }
            #modalSemak .qr-info { min-width: 0; flex: 1; }
            #modalSemak .qr-lokasi-no { font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase; letter-spacing: .04em; }
            #modalSemak .qr-lokasi { font-weight: 700; color: #212529; font-size: 13.5px; word-break: break-word; }
            #modalSemak .qr-kod { font-family: Consolas, "Courier New", monospace; font-size: 12px; color: #495057; margin: 2px 0 8px; }
            #modalSemak .qr-actions { display: flex; flex-wrap: wrap; gap: 6px; }
            #modalSemak .qr-actions .qr-btn { white-space: nowrap; }
            #modalSemak .qr-btn {
                display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 6px;
                border: 1px solid #d0d5dd; background: #fff; color: #344054 !important;
                font-weight: 600; font-size: 12px; text-decoration: none;
            }
            #modalSemak .qr-btn:hover { background: #f2f4f7; }
            #modalSemak .qr-btn-primary { background: #2E3192; border-color: #2E3192; color: #fff !important; }
            #modalSemak .qr-btn-primary:hover { background: #23267a; }

            @media (max-width: 576px) {
                #modalSemak .qr-panel { padding: 12px; }
                #modalSemak .qr-panel-head .qr-btn { width: 100%; justify-content: center; }
                #modalSemak .qr-grid { grid-template-columns: 1fr; }
                #modalSemak .qr-img { width: 88px; height: 88px; }
            }
        </style>
        <script>
            // Buka/tutup panel QR sebagai baris penuh di bawah baris permohonan
            function toggleQrPanel(btn) {
                var tr = btn.closest('tr');
                var next = tr.nextElementSibling;
                if (next && next.classList.contains('qr-detail-row')) {
                    next.hidden = !next.hidden;
                } else {
                    var src = tr.querySelector('.qr-panel-src');
                    if (!src) return;
                    next = document.createElement('tr');
                    next.className = 'qr-detail-row';
                    var td = document.createElement('td');
                    td.colSpan = tr.children.length;
                    td.appendChild(src.firstElementChild);
                    next.appendChild(td);
                    tr.parentNode.insertBefore(next, tr.nextSibling);
                }
                btn.classList.toggle('open', !next.hidden);
                btn.setAttribute('aria-expanded', next.hidden ? 'false' : 'true');
            }
        </script>

